{
  "name": "@dolphinclient/launcher",
  "version": "0.1.0",
  "private": true,
  "description": "DolphinClient desktop launcher (Electron).",
  "author": "DolphinClient <user@example.invalid>",
  "homepage": "https://example.invalid",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "dev": "npm run build && electron .",
    "start": "electron .",
    "dist": "npm run build && electron-builder"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.5",
    "@types/node": "^22.0.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "electron-updater": "^6.3.0"
  },
  "build": {
    "appId": "com.dolphinclient.launcher",
    "productName": "DolphinClient",
    "electronVersion": "33.4.11",
    "npmRebuild": false,
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*"
    ],
    "extraResources": [
      {
        "from": "resources/mods",
        "to": "mods"
      }
    ],
    "publish": [
      {
        "provider": "generic",
        "url": "https://example.invalid/downloads/"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.games",
      "identity": null,
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Game",
      "maintainer": "DolphinClient <user@example.invalid>",
      "synopsis": "Performance-focused Minecraft client launcher (target 26.1)"
    }
  }
}
