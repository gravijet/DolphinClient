# Azure-App-Client-ID (einmalig registriert; Endnutzer sehen das nie).
# Azure Portal -> App registrations -> New registration
#   - Supported account types: Personal Microsoft accounts
#   - Authentication -> "Allow public client flows" = Yes
DOLPHIN_MS_CLIENT_ID=fee9e26b-cfdd-4c9d-b15a-294f01172f66

# Optional: Pfad zur JDK-25-Java-Binärdatei (sonst wird "java" aus PATH genutzt).
DOLPHIN_JDK25=

# Optional: zugewiesener Arbeitsspeicher (Default 4G).
DOLPHIN_RAM=4G

# Auto-Update-Feed (electron-updater). Ohne diese Variable wird der Update-Check
# in der Entwicklung übersprungen.
DOLPHIN_UPDATE_URL=https://api.dolphinclient.example/v1/updates/stable/
